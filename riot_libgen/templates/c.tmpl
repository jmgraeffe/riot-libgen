{# shared macros for rendering C declarations; all macros render a single line without trailing newline #}
{% macro element_type(library, element) %}
{% if element.is_struct() %}
{{ library.structs[element.struct].type }}
{%- elif element.is_pointer_handle() %}
{{ library.pointer_handles[element.pointer_handle].type }}
{%- else %}
{{ element.type }}
{%- endif %}
{% endmacro %}
{% macro type_and_name(library, parameter) %}
{# output parameters are pointers to their type, except for arrays and byte arrays (which are pointers already) #}
{% set pointer = '*' if parameter.is_output() and not parameter.is_byte_array() else '' %}
{% if parameter.is_array() %}
{{ element_type(library, parameter._element_parameter) }} {{ parameter.name }}[{{ parameter.array_size }}]
{%- elif parameter.is_struct() %}
{{ library.structs[parameter.struct].type }}{{ pointer }} {{ parameter.name }}
{%- elif parameter.is_pointer_handle() %}
{{ library.pointer_handles[parameter.pointer_handle].type }}{{ pointer }} {{ parameter.name }}
{%- else %}
{{ parameter.type }}{{ pointer }} {{ parameter.name }}
{%- endif %}
{% endmacro %}
{% macro parameter_list(library, function) %}
{% for parameter in function.parameters.values() %}
{{ type_and_name(library, parameter) }}{{ ", " if not loop.last }}
{%- else %}
void
{%- endfor %}
{% endmacro %}
{% macro function_handle_return_type(library, handle) %}
{% if handle.returns_struct() %}
{{ library.structs[handle.returned_struct].type }}
{%- elif handle.returns_pointer_handle() %}
{{ library.pointer_handles[handle.returned_pointer_handle].type }}
{%- else %}
{{ handle.return_type }}
{%- endif %}
{% endmacro %}
{% macro function_return_type(library, function) %}
{% if function.returns_struct() %}
{{ library.structs[function.returned_struct].type }}
{%- elif function.returns_pointer_handle() %}
{{ library.pointer_handles[function.returned_pointer_handle].type }}
{%- else %}
{{ function.return_type }}
{%- endif %}
{% endmacro %}
