{% import 'templates/c.tmpl' as c %}
{% macro parameter_declaration(library, parameter) %}
{% if parameter.is_function_handle() %}
{% set handle = library.function_handles[parameter.function_handle] %}
{{ c.function_handle_return_type(library, handle) }} (*{{ parameter.name }})({{ c.parameter_list(library, handle) }})
{%- else %}
{{ c.type_and_name(library, parameter) }}
{%- endif %}
{% endmacro %}
// forward declarations so that functions are well declared even if defined in user code
{% for library in libraries.values() %}
{% for function in library.functions.values() if function.declare %}
{{ c.function_return_type(library, function) }} {{ function.original_name }}(
{%- for parameter in function.parameters.values() %}
{{ parameter_declaration(library, parameter) }}{{ ", " if not loop.last }}
{%- else %}
void
{%- endfor %}
);
{% endfor %}
{% endfor %}
