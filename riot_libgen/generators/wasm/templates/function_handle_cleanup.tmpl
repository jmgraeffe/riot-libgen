{% macro string_byte_array(library, handle, param, index) %}
{# TODO 32bit memory model assumed for strings ($), might become variable in the future #}
{% if param.get_wasm_runtime_signature() == 'i' or param.get_wasm_runtime_signature() == '$' %}
wasm_runtime_module_free(wasm_module_inst, (uint64_t) args[{{ index }}].of.i32);
{% else %}
wasm_runtime_module_free(wasm_module_inst, (uint64_t) args[{{ index }}].of.i64);
{% endif %}
{% endmacro %}

{% macro struct_array(library, handle, param, index) %}
{# copies of structs and arrays are always passed as i32, see function_handle_parameters.tmpl #}
wasm_runtime_module_free(wasm_module_inst, (uint64_t) args[{{ index }}].of.i32);
{% endmacro %}
