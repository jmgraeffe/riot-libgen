{% macro struct(library, function, parameter) %}
{{ parameter.name }}_struct
{% endmacro %}

{% macro function_handle(library, function, parameter) %}
function_handle_internal_function_{{ library.name }}_{{ parameter.function_handle }}
{% endmacro %}

{% macro pointer_handle(library, function, parameter) %}
{{ parameter.name }}_ptr
{% endmacro %}

{% macro output(library, function, parameter) %}
{% if parameter.is_array() %}
{{ parameter.name }}_guest != NULL ? {{ parameter.name }}_array : NULL
{% elif parameter.is_byte_array() %}
{{ parameter.name }}
{% else %}
{{ parameter.name }}_guest != NULL ? &{{ parameter.name }}_value : NULL
{% endif %}
{% endmacro %}

{% macro array(library, function, parameter) %}
{{ parameter.name }}_guest != NULL ? {{ parameter.name }}_array : NULL
{% endmacro %}
