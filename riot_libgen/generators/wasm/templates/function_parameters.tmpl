{% import 'templates/c.tmpl' as c %}
{% import 'generators/wasm/templates/conversion.tmpl' as conversion %}

{% macro struct(library, function, parameter) %}
{% set struct = library.structs[parameter.struct] %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
if (!wasm_runtime_validate_app_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }}, {{ struct.guest_size }})) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with a struct parameter '{{ parameter.name }}' that does not lie in the WASM memory region");
}
{# fields that are not declared keep their zero values #}
{{ struct.type }} {{ parameter.name }}_struct = { 0 };
{
    const uint8_t* libgen_guest = (const uint8_t*) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
    {{ conversion.to_host(library, parameter, 'libgen_guest', parameter.name ~ '_struct')|trim|indent(4) }}
}
{% endmacro %}

{% macro array(library, function, parameter) %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
{# NULL (0) is passed as is, otherwise the array is converted to a host array (and back for output parameters) #}
uint8_t* {{ parameter.name }}_guest = NULL;
if ({{ parameter.name }} != NULL) {
    if (!wasm_runtime_validate_app_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }}, {{ parameter.guest_size() }})) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with an array parameter '{{ parameter.name }}' that does not lie in the WASM memory region");
    }
    {{ parameter.name }}_guest = (uint8_t*) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
}
{{ conversion.host_type(library, parameter._element_parameter) }} {{ parameter.name }}_array[{{ parameter.array_size }}];
memset({{ parameter.name }}_array, 0, sizeof({{ parameter.name }}_array));
{% if not parameter.is_output() %}
if ({{ parameter.name }}_guest != NULL) {
    {{ conversion.to_host(library, parameter, parameter.name ~ '_guest', parameter.name ~ '_array')|trim|indent(4) }}
}
{% endif %}
{% endmacro %}

{% macro function_handle(library, function, parameter) %}
if (strlen({{ parameter.name }}) > WASM_LIBS_FUNCTION_HANDLE_MAX_LENGTH) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function handle name is too long (> WASM_LIBS_FUNCTION_HANDLE_MAX_LENGTH)");
}
strcpy(function_handle_next_function_name_{{ library.name }}_{{ parameter.function_handle }}, {{ parameter.name }});
{% endmacro %}

{% macro pointer_handle(library, function, parameter) %}
{{ library.pointer_handles[parameter.pointer_handle].type }} {{ parameter.name }}_ptr = ({{ library.pointer_handles[parameter.pointer_handle].type }}) pointer_handles_get_{{ library.name }}_{{ parameter.pointer_handle }}({{ parameter.name }});
{% endmacro %}

{% macro byte_array(library, function, parameter) %}
{# we need to ensure there is a length parameter, and it is of number type #}
{% if parameter.length_parameter not in function.parameters %}
{% raise "library '" ~ library.name ~ "', function '" ~ function.name ~ "', parameter '" ~ parameter.name ~ "': length parameter '" ~ parameter.length_parameter ~ "' does not exist as parameter" %}
{% endif %}
{% if not function.parameters[parameter.length_parameter].is_integer() %}
{% raise "library '" ~ library.name ~ "', function '" ~ function.name ~ "', parameter '" ~ parameter.name ~ "': length parameter '" ~ parameter.length_parameter ~ "' is not an integer" %}
{% endif %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
{# NULL (0) is passed as is, otherwise the whole range given by the length parameter needs to be in the WASM memory #}
if ({{ parameter.name }} != NULL) {
    if (!wasm_runtime_validate_app_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }}, {{ parameter.length_parameter }})) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with a byte array parameter '{{ parameter.name }}' that does not lie in the WASM memory region (with length '{{ parameter.length_parameter }}')");
    }
    {{ parameter.name }} = ({{ parameter.type }}) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
}
{% endmacro %}

{% macro string(library, function, parameter) %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
{# NULL (0) is passed as is, otherwise the string (including its terminating '\0') needs to be in the WASM memory #}
if ({{ parameter.name }} != NULL) {
    if (!wasm_runtime_validate_app_str_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }})) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with a string parameter '{{ parameter.name }}' that does not lie in the WASM memory region");
    }
    {{ parameter.name }} = ({{ parameter.type }}) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
}
{% endmacro %}

{% macro output(library, function, parameter) %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
{# NULL (0) is passed as is, otherwise the host function fills a host value, which is converted afterwards #}
uint8_t* {{ parameter.name }}_guest = NULL;
if ({{ parameter.name }} != NULL) {
    if (!wasm_runtime_validate_app_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }}, {{ parameter.guest_size() }})) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with an output parameter '{{ parameter.name }}' that does not lie in the WASM memory region");
    }
    {{ parameter.name }}_guest = (uint8_t*) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
}
{{ conversion.host_type(library, parameter) }} {{ parameter.name }}_value = { 0 };
{% endmacro %}

{% macro store_output(library, function, parameter) %}
{% if parameter.is_array() %}
if ({{ parameter.name }}_guest != NULL) {
    {{ conversion.to_guest(library, parameter, parameter.name ~ '_guest', parameter.name ~ '_array')|trim|indent(4) }}
}
{% elif not parameter.is_byte_array() %}
if ({{ parameter.name }}_guest != NULL) {
    {{ conversion.to_guest(library, parameter, parameter.name ~ '_guest', parameter.name ~ '_value')|trim|indent(4) }}
}
{% endif %}
{% endmacro %}

{% macro allocated_reference(library, function, parameter) %}
{% set type = c.referenced_type(library, parameter.referenced) %}
{{ type }}* {{ parameter.name }}_ptr = ({{ type }}*) allocated_get_{{ library.name }}_{{ parameter.referenced.name }}({{ parameter.name }});
{% endmacro %}

{% macro const_reference(library, function, parameter) %}
{% set referenced = parameter.referenced %}
{% set guest_size = referenced.parameter.guest_size() if referenced.is_array() else referenced.guest_size %}
if (wasm_module_inst == NULL) {
    core_panic(PANIC_GENERAL_ERROR, "wasm_libs: WASM module instance is not set (use wasm_libs_set_wasm_module_inst)");
}
{# NULL (0) is passed as is, otherwise the struct or array is converted to a temporary copy on the host #}
{% if referenced.is_array() %}
{{ conversion.host_type(library, referenced.element) }} {{ parameter.name }}_array[{{ referenced.size }}];
memset({{ parameter.name }}_array, 0, sizeof({{ parameter.name }}_array));
{% else %}
{# fields that are not declared keep their zero values #}
{{ referenced.type }} {{ parameter.name }}_struct = { 0 };
{% endif %}
if ({{ parameter.name }} != NULL) {
    if (!wasm_runtime_validate_app_addr(wasm_module_inst, (uintptr_t) {{ parameter.name }}, {{ guest_size }})) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: function '{{ library.prefix }}{{ function.name }}' was called with a {{ referenced.kind }} pointer parameter '{{ parameter.name }}' that does not lie in the WASM memory region");
    }
    const uint8_t* libgen_guest = (const uint8_t*) wasm_runtime_addr_app_to_native(wasm_module_inst, (uintptr_t) {{ parameter.name }});
{% if referenced.is_array() %}
    {{ conversion.to_host(library, referenced.parameter, 'libgen_guest', parameter.name ~ '_array')|trim|indent(4) }}
{% else %}
    {{ conversion.struct_to_host(library, referenced, 'libgen_guest', parameter.name ~ '_struct')|trim|indent(4) }}
{% endif %}
}
{% endmacro %}
