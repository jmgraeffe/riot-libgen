{% import 'generators/wasm/templates/conversion.tmpl' as conversion %}

{% macro struct(library, handle, param, dest) %}
{# TODO 32bit memory model assumed, might become variable in the future #}
{
    uint8_t* libgen_guest = NULL;
    {{ dest }}.kind = WASM_I32;
    {{ dest }}.of.i32 = (int32_t) wasm_runtime_module_malloc(wasm_module_inst, {{ library.structs[param.struct].guest_size }}, (void**) &libgen_guest);
    if (libgen_guest == NULL) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: could not allocate memory in the WASM application");
    }
    {{ conversion.to_guest(library, param, 'libgen_guest', param.name)|trim|indent(4) }}
}
{% endmacro %}

{% macro array(library, handle, param, dest) %}
{# TODO 32bit memory model assumed, might become variable in the future #}
{
    uint8_t* libgen_guest = NULL;
    {{ dest }}.kind = WASM_I32;
    {{ dest }}.of.i32 = (int32_t) wasm_runtime_module_malloc(wasm_module_inst, {{ param.guest_size() }}, (void**) &libgen_guest);
    if (libgen_guest == NULL) {
        core_panic(PANIC_GENERAL_ERROR, "wasm_libs: could not allocate memory in the WASM application");
    }
    {{ conversion.to_guest(library, param, 'libgen_guest', param.name)|trim|indent(4) }}
}
{% endmacro %}

{% macro pointer_handle(library, handle, param, dest) %}
{% if param.get_wasm_runtime_signature() == 'i' %}
{{ dest }}.kind = WASM_I32;
{{ dest }}.of.i32 = pointer_handles_get_or_add_{{ library.name }}_{{ param.pointer_handle }}((void*) {{ param.name }});
{% else %}
{{ dest }}.kind = WASM_I64;
{{ dest }}.of.i64 = pointer_handles_get_or_add_{{ library.name }}_{{ param.pointer_handle }}((void*) {{ param.name }});
{% endif %}
{% endmacro %}

{% macro byte_array(library, handle, param, dest) %}
{# we need to ensure there is a length parameter, and it is of number type #}
{% if param.length_parameter not in handle.parameters %}
{% raise "library '" ~ library.name ~ "', function handle '" ~ handle.name ~ "', parameter '" ~ param.name ~ "': length parameter '" ~ param.length_parameter ~ "' does not exist as parameter" %}
{% endif %}
{% if not handle.parameters[param.length_parameter].is_integer() %}
{% raise "library '" ~ library.name ~ "', function handle '" ~ handle.name ~ "', parameter '" ~ param.name ~ "': length parameter '" ~ param.length_parameter ~ "' is not an integer" %}
{% endif %}
{# considering pointer length already even though WAMR is 32bit memory model atm #}
{# NULL is passed as 0 #}
{% if param.get_wasm_runtime_signature() == 'i' %}
{{ dest }}.kind = WASM_I32;
{{ dest }}.of.i32 = {{ param.name }} != NULL ? (int32_t) wasm_runtime_module_dup_data(wasm_module_inst, (const char*) {{ param.name }}, {{ param.length_parameter }}) : 0;
{% else %}
{{ dest }}.kind = WASM_I64;
{{ dest }}.of.i64 = {{ param.name }} != NULL ? (int64_t) wasm_runtime_module_dup_data(wasm_module_inst, (const char*) {{ param.name }}, {{ param.length_parameter }}) : 0;
{% endif %}
{% endmacro %}

{% macro string(library, handle, param, dest) %}
{# TODO 32bit memory model assumed, might become variable in the future #}
{{ dest }}.kind = WASM_I32;
{# + 1 to copy the terminating '\0' as well, NULL is passed as 0 #}
{{ dest }}.of.i32 = {{ param.name }} != NULL ? (int32_t) wasm_runtime_module_dup_data(wasm_module_inst, (const char*) {{ param.name }}, strlen((const char*) {{ param.name }}) + 1) : 0;
{% endmacro %}
