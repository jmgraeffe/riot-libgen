{% import 'templates/c.tmpl' as c %}
{% import 'generators/js/templates/function_parameters.tmpl' as tmpl_function_parameters %}
{% import 'generators/js/templates/function_call.tmpl' as tmpl_function_call %}
{% import 'generators/js/templates/function_cleanup.tmpl' as tmpl_function_cleanup %}
{% import 'generators/js/templates/function_returns.tmpl' as tmpl_function_returns %}
{% import 'generators/js/templates/function_handle_parameters.tmpl' as tmpl_function_handle_parameters %}
{% import 'generators/js/templates/function_handle_returns.tmpl' as tmpl_function_handle_returns %}
{% import 'generators/js/templates/function_outputs.tmpl' as tmpl_function_outputs %}
#include <stdlib.h>
#include <string.h>
#include <panic.h>

#include "js_libs.h"

#define JS_LIBS_FUNCTION_HANDLE_MAX_LENGTH (255)
{% set libs_prefix = 'js_libs' %}
{% include 'templates/pointer_handles.tmpl' %}
{% include 'templates/allocatables.tmpl' %}

static jerry_value_t empty_constructor(const jerry_value_t func_val,
                                       const jerry_value_t this_val,
                                       const jerry_value_t argv[],
                                       const jerry_length_t argc) {
    (void) func_val;
    (void) this_val;
    (void) argv;
    (void) argc;

    return jerry_create_undefined();
}
{% for library in libraries.values() %}
{% for handle in library.function_handles.values() %}

static char function_handle_next_function_name_{{ library.name }}_{{ handle.name }}[JS_LIBS_FUNCTION_HANDLE_MAX_LENGTH + 1] = {'\0'};
static {{ c.function_handle_return_type(library, handle) }} function_handle_internal_function_{{ library.name }}_{{ handle.name }}({{ c.parameter_list(library, handle) }}) {
    // lookup name of function handle in engine context
    jerry_value_t global_object = jerry_get_global_object();
    jerry_value_t name = jerry_create_string((const jerry_char_t *) function_handle_next_function_name_{{ library.name }}_{{ handle.name }});
    jerry_value_t func = jerry_get_property(global_object, name);
    if (jerry_value_is_error(func)) {
        char msg[512] = {'\0'};
        sprintf(msg, "js_libs: lookup of function '%s' failed", function_handle_next_function_name_{{ library.name }}_{{ handle.name }});
        core_panic(PANIC_GENERAL_ERROR, msg);
    }

    // construct parameters for upcoming call
    jerry_value_t args[{{ [handle.parameters|length, 1]|max }}];
    {% for param in handle.parameters.values() %}
        {% set dest = 'args[' ~ loop.index0 ~ ']' %}
        {% if param.is_struct() %}
    {{ tmpl_function_handle_parameters.struct(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_array() %}
    {{ tmpl_function_handle_parameters.array(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_pointer_handle() %}
    {{ tmpl_function_handle_parameters.pointer_handle(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_number() %}
    {{ tmpl_function_handle_parameters.number(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_boolean() %}
    {{ tmpl_function_handle_parameters.boolean(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_string() %}
    {{ tmpl_function_handle_parameters.string(library, handle, param, dest)|trim|indent(4) }}
        {% elif param.is_byte_array() %}
    {{ tmpl_function_handle_parameters.byte_array(library, handle, param, dest)|trim|indent(4) }}
        {% else %}
            {% raise "library '" ~ library.name ~ "', function handle '" ~ handle.name ~ "', parameter '" ~ param.name ~ "': unsupported type '" ~ param.type ~ "' (Maybe it is a function handle? Function handles as parameters of function handles not supported yet.)" %}
        {% endif %}
    {% endfor %}

    // call function handle
    jerry_value_t res_value = jerry_call_function(func, global_object, args, {{ handle.parameters|length }});
    {% if handle.return_type != 'void' %}

        {% if handle.returns_struct() %}
    {{ tmpl_function_handle_returns.struct(library, handle, param)|trim|indent(4) }}
        {% elif handle.returns_pointer_handle() %}
    {{ tmpl_function_handle_returns.pointer_handle(library, handle, param)|trim|indent(4) }}
        {% elif handle.returns_number() %}
    {{ tmpl_function_handle_returns.number(library, handle, param)|trim|indent(4) }}
        {% elif handle.returns_boolean() %}
    {{ tmpl_function_handle_returns.boolean(library, handle, param)|trim|indent(4) }}
        {% else %}
            {% raise "library '" ~ library.name ~ "', function handle '" ~ handle.name ~ "', return type: unsupported type '" ~ handle.return_type ~ "' (Maybe it is a function handle? Function handles as parameters of function handles not supported yet.)" %}
        {% endif %}
    {% endif %}

    // cleanup
    jerry_release_value(global_object);
    jerry_release_value(name);
    jerry_release_value(func);
    {% for param in handle.parameters.values() %}
    jerry_release_value(args[{{ loop.index0 }}]);
    {% endfor %}
    jerry_release_value(res_value);
    {% if handle.return_type != 'void' %}

    return res;
    {% endif %}
}
{% endfor %}
{% for function in library.functions.values() %}

static jerry_value_t {{ library.name }}_{{ function.name }}_native(
    const jerry_value_t func_val,
    const jerry_value_t this_val,
    const jerry_value_t argv[],
    const jerry_length_t argc
) {
    (void) func_val;
    (void) this_val;
    (void) argc;
    {% if not function.parameters %}
    (void) argv;
    {% endif %}
    {% set prepare %}
        {% for parameter in function.parameters.values() %}
            {% set container = 'argv[' ~ loop.index0 ~ ']' %}
            {% if parameter.is_allocated_reference() %}
if (!jerry_value_is_number({{ container }})) {
    core_panic(PANIC_GENERAL_ERROR, "js_libs: library '{{ library.name }}', function '{{ function.name }}', parameter '{{ parameter.name }}': not an instance of {{ parameter.referenced.kind }} '{{ parameter.referenced.name }}'");
}
{{ c.type_and_name(library, parameter) }} = ({{ c.referenced_type(library, parameter.referenced) }}*) allocated_get_{{ library.name }}_{{ parameter.referenced.name }}((int64_t) jerry_get_number_value({{ container }}));

            {% elif parameter.is_array_reference() %}
{# const pointer to an array that is not allocatable: a temporary copy is passed #}
{{ tmpl_function_parameters.array(library, function, namespace(name=parameter.name, array_size=parameter.referenced.size, _element_parameter=parameter.referenced.element), container)|trim }}

            {% elif parameter.is_reference() %}
{# const pointer to a struct that is not allocatable: a temporary copy is passed #}
{{ tmpl_function_parameters.struct(library, function, namespace(name=parameter.name, struct=parameter.referenced_struct), container)|trim }}

            {% elif parameter.is_output() %}
{{ tmpl_function_outputs.prepare(library, function, parameter, container)|trim }}

            {% elif parameter.is_struct() %}
{{ tmpl_function_parameters.struct(library, function, parameter, container)|trim }}

            {% elif parameter.is_array() %}
{{ tmpl_function_parameters.array(library, function, parameter, container)|trim }}

            {% elif parameter.is_function_handle() %}
{{ tmpl_function_parameters.function_handle(library, function, parameter, container)|trim }}

            {% elif parameter.is_pointer_handle() %}
{{ tmpl_function_parameters.pointer_handle(library, function, parameter, container)|trim }}

            {% elif parameter.is_number() %}
{{ tmpl_function_parameters.number(library, function, parameter, container)|trim }}

            {% elif parameter.is_boolean() %}
{{ tmpl_function_parameters.boolean(library, function, parameter, container)|trim }}

            {% elif parameter.is_string() or parameter.is_byte_array() %}
{{ tmpl_function_parameters.string_byte_array(library, function, parameter, container)|trim }}

            {% else %}
                {% raise "library '" ~ library.name ~ "', function '" ~ function.name ~ "', parameter '" ~ parameter.name ~ "': unsupported type '" ~ parameter.type ~ "'" %}
            {% endif %}
        {% endfor %}
        {# byte arrays are copied from strings, the length parameter must not exceed what was copied #}
        {% for parameter in function.parameters.values() if parameter.is_byte_array() and not parameter.is_output() %}
if ((size_t) {{ parameter.length_parameter }} > length_{{ parameter.name }}) {
    core_panic(PANIC_GENERAL_ERROR, "js_libs: library '{{ library.name }}', function '{{ function.name }}', parameter '{{ parameter.name }}': length parameter '{{ parameter.length_parameter }}' is larger than the byte array");
}

        {% endfor %}
        {# byte arrays as output parameters need a buffer with the size given by the length parameter #}
        {% for parameter in function.parameters.values() if parameter.is_byte_array() and parameter.is_output() %}
{{ tmpl_function_outputs.allocate(library, function, parameter)|trim }}

        {% endfor %}
    {% endset %}
    {% if prepare|trim %}

    // prepare function parameters
    {# TODO argv length check #}
    {{ prepare|trim|indent(4) }}
    {% endif %}

    // call native function
    {% set result %}{% if function.return_type != 'void' %}{{ c.function_return_type(library, function) }} libgen_res = {% endif %}{% endset %}
    {% if function.parameters %}
    {{ result }}{{ function.original_name }}(
        {% for parameter in function.parameters.values() %}
            {% if parameter.is_struct_reference() and not parameter.is_allocated_reference() %}
        &{{ parameter.name }}{{ "," if not loop.last }}
            {% elif parameter.is_output() %}
        {{ tmpl_function_outputs.argument(library, function, parameter)|trim }}{{ "," if not loop.last }}
            {% elif parameter.is_function_handle() %}
        {{ tmpl_function_call.function_handle(library, function, parameter)|trim }}{{ "," if not loop.last }}
            {% elif parameter.is_string() or parameter.is_byte_array() %}
        {{ tmpl_function_call.string_byte_array(library, function, parameter)|trim }}{{ "," if not loop.last }}
            {% else %}
        {{ parameter.name }}{{ "," if not loop.last }}
            {% endif %}
        {% endfor %}
    );
    {% else %}
    {{ result }}{{ function.original_name }}();
    {% endif %}
    {% set outputs %}
        {% for parameter in function.parameters.values() %}
            {# loop.index0 is the index of the parameter in argv, so the loop must not be filtered #}
            {% if parameter.is_output() %}
{{ tmpl_function_outputs.store(library, function, parameter, 'argv[' ~ loop.index0 ~ ']')|trim }}

            {% endif %}
        {% endfor %}
    {% endset %}
    {% if outputs|trim %}

    // store output parameters
    {{ outputs|trim|indent(4) }}
    {% endif %}
    {% set cleanup %}
        {% for parameter in function.parameters.values() %}
            {# output strings point to host memory, output byte arrays were allocated in any case #}
            {% if (parameter.is_string() and not parameter.is_output()) or parameter.is_byte_array() %}
{{ tmpl_function_cleanup.string_byte_array(library, function, parameter)|trim }}
            {% endif %}
        {% endfor %}
    {% endset %}
    {% if cleanup|trim %}

    // cleanup
    {{ cleanup|trim|indent(4) }}
    {% endif %}

    {% if function.return_type == 'void' %}
    {{ tmpl_function_returns.void(library, function)|trim|indent(4) }}
    {% elif function.returns_struct() %}
    {{ tmpl_function_returns.struct(library, function)|trim|indent(4) }}
    {% elif function.returns_pointer_handle() %}
    {{ tmpl_function_returns.pointer_handle(library, function)|trim|indent(4) }}
    {% elif function.returns_number() %}
    {{ tmpl_function_returns.number(library, function)|trim|indent(4) }}
    {% elif function.returns_boolean() %}
    {{ tmpl_function_returns.boolean(library, function)|trim|indent(4) }}
    {% else %}
        {% raise "library '" ~ library.name ~ "', function '" ~ function.name ~ "', return type: unsupported type '" ~ function.return_type ~ "' (Maybe it is a function handle? Function handles as return types are not supported yet.)" %}
    {% endif %}
}
{% endfor %}
{% for item in library.allocatables %}
    {% set type = c.referenced_type(library, item) %}

static jerry_value_t {{ library.name }}_{{ item.new_function }}_native(
    const jerry_value_t func_val,
    const jerry_value_t this_val,
    const jerry_value_t argv[],
    const jerry_length_t argc
) {
    (void) func_val;
    (void) this_val;

    {{ type }}* instance = ({{ type }}*) calloc({{ item.size if item.is_array() else 1 }}, sizeof({{ type }}));
    if (instance == NULL) {
        core_panic(PANIC_GENERAL_ERROR, "js_libs: could not allocate memory");
    }
    if (argc > 0 && !jerry_value_is_undefined(argv[0]) && !jerry_value_is_null(argv[0])) {
    {% if item.is_array() %}
        {{ tmpl_function_parameters.array(library, namespace(name=item.new_function), namespace(name='libgen_init', array_size=item.size, _element_parameter=item.element), 'argv[0]')|trim|indent(8) }}
        memcpy(instance, libgen_init, sizeof(libgen_init));
    {% else %}
        {{ tmpl_function_parameters.struct(library, namespace(name=item.new_function), namespace(name='libgen_init', struct=item.name), 'argv[0]')|trim|indent(8) }}
        *instance = libgen_init;
    {% endif %}
    }
    return jerry_create_number(allocated_add_{{ library.name }}_{{ item.name }}(instance));
}

static jerry_value_t {{ library.name }}_{{ item.free_function }}_native(
    const jerry_value_t func_val,
    const jerry_value_t this_val,
    const jerry_value_t argv[],
    const jerry_length_t argc
) {
    (void) func_val;
    (void) this_val;

    if (argc < 1 || !jerry_value_is_number(argv[0])) {
        core_panic(PANIC_GENERAL_ERROR, "js_libs: library '{{ library.name }}', function '{{ item.free_function }}': not an instance of {{ item.kind }} '{{ item.name }}'");
    }
    {{ type }}* instance = ({{ type }}*) allocated_remove_{{ library.name }}_{{ item.name }}((int64_t) jerry_get_number_value(argv[0]));
    free(instance);
    return jerry_create_boolean(instance != NULL);
}
{% endfor %}
{% endfor %}
{% for library in libraries.values() %}

int js_libs_register_{{ library.name }}_natives(void) {
    jerry_value_t constructor = jerry_create_external_function(empty_constructor);
    jerry_value_t library_object = jerry_construct_object(constructor, NULL, 0);

    // export natives and add them to library object
    {% set ns = namespace(natives=library.functions.values()|map(attribute='name')|list) %}
    {% for item in library.allocatables %}
        {% set ns.natives = ns.natives + [item.new_function, item.free_function] %}
    {% endfor %}
    {% for native in ns.natives %}
    {
        jerry_value_t property_name_function = jerry_create_string((const jerry_char_t*) ("{{ native }}"));
        jerry_value_t property_value_function = jerry_create_external_function({{ library.name }}_{{ native }}_native);
        jerry_value_t res = jerry_set_property(library_object, property_name_function, property_value_function);
        if (jerry_value_is_error(res)) {
            printf("js_libs: could not register natives for library '{{ library.name }}'");
            jerry_release_value(property_name_function);
            jerry_release_value(property_value_function);
            jerry_release_value(res);
            return 0;
        }

        jerry_release_value(property_name_function);
        jerry_release_value(property_value_function);
        jerry_release_value(res);
    }
    {% endfor %}

    // define constants and add them to library object
    {% for name, value in library.constants.items() %}
    {
        {# constants are properties of the library object, so the prefix of the library is not needed #}
        jerry_value_t property_name_constant = jerry_create_string((const jerry_char_t*) ("{{ name|upper }}"));
        {% if value is string %}
        jerry_value_t property_value_constant = jerry_create_string((const jerry_char_t*) ("{{ value }}"));
        {% elif value is number %}
        jerry_value_t property_value_constant = jerry_create_number({{ value }});
        {% else %}
            {% raise "library '" ~ library.name ~ "', constant '" ~ name ~ "': unsupported type (only strings and numbers)" %}
        {% endif %}
        jerry_value_t res = jerry_set_property(library_object, property_name_constant, property_value_constant);
        if (jerry_value_is_error(res)) {
            printf("js_libs: could not register constants for library '%s'", "{{ library.name }}");
            jerry_release_value(property_name_constant);
            jerry_release_value(property_value_constant);
            jerry_release_value(res);
            return 0;
        }

        jerry_release_value(property_name_constant);
        jerry_release_value(property_value_constant);
        jerry_release_value(res);
    }
    {% endfor %}

    // put library as property into global object
    jerry_value_t global_object = jerry_get_global_object();
    jerry_value_t property_name_library = jerry_create_string((const jerry_char_t*) ("{{ library.name }}"));
    jerry_value_t res = jerry_set_property(global_object, property_name_library, library_object);
    if (jerry_value_is_error(res)) {
        printf("js_libs: could not register library '%s'", "{{ library.name }}");
        jerry_release_value(constructor);
        jerry_release_value(library_object);
        jerry_release_value(global_object);
        jerry_release_value(property_name_library);
        jerry_release_value(res);
        return 0;
    }

    // cleanup
    jerry_release_value(constructor);
    jerry_release_value(library_object);
    jerry_release_value(global_object);
    jerry_release_value(property_name_library);
    jerry_release_value(res);

    return {{ library.functions|length }};
}
{% endfor %}

void js_libs_extract_error_message(jerry_value_t error_value) {
    if (!jerry_value_is_error(error_value)) {
        printf("Provided value is not an error object.\n");
        return;
    }

    jerry_value_t error_obj = jerry_get_value_from_error(error_value, true);

    jerry_value_t message_prop_name = jerry_create_string((const jerry_char_t*)"message");
    jerry_value_t message_value = jerry_get_property(error_obj, message_prop_name);

    if (jerry_value_is_string(message_value)) {
        jerry_size_t message_size = jerry_get_string_size(message_value);
        char *message_buffer = (char *)malloc(message_size + 1);
        if (message_buffer) {
            jerry_string_to_char_buffer(message_value, (jerry_char_t *)message_buffer, message_size);
            message_buffer[message_size] = '\0';

            printf("Error message: %s\n", message_buffer);

            free(message_buffer);
        }
    } else {
        printf("Error object does not have a 'message' property or it is not a string.\n");
    }

    jerry_release_value(message_value);
    jerry_release_value(message_prop_name);
    jerry_release_value(error_obj);
}
