{% import 'generators/js/templates/function_parameters.tmpl' as tmpl_function_parameters %}

{% macro struct(library, handle, param) %}
if (!jerry_value_is_object(res_value)) {
    char msg[512] = {'\0'};
    sprintf(msg, "js_libs: returned type of function handle '%s' is not as expected (not a struct/object)", function_handle_next_function_name_{{ library.name }}_{{ handle.name }});
    core_panic(PANIC_GENERAL_ERROR, msg);
}
{{ tmpl_function_parameters.struct(library, handle, namespace(name='res', struct=handle.returned_struct), 'res_value')|trim }}
{% endmacro %}

{% macro pointer_handle(library, handle, param) %}
if (!jerry_value_is_number(res_value)) {
    char msg[512] = {'\0'};
    sprintf(msg, "js_libs: returned type of function handle '%s' is not as expected (not a pointer handle)", function_handle_next_function_name_{{ library.name }}_{{ handle.name }});
    core_panic(PANIC_GENERAL_ERROR, msg);
}
{{ library.pointer_handles[handle.returned_pointer_handle].type }} res = ({{ library.pointer_handles[handle.returned_pointer_handle].type }}) pointer_handles_get_{{ library.name }}_{{ handle.returned_pointer_handle }}((int64_t) jerry_get_number_value(res_value));
{% endmacro %}

{% macro number(library, handle, param) %}
if (!jerry_value_is_number(res_value)) {
    char msg[512] = {'\0'};
    sprintf(msg, "js_libs: returned type of function handle '%s' is not as expected (not a number)", function_handle_next_function_name_{{ library.name }}_{{ handle.name }});
    core_panic(PANIC_GENERAL_ERROR, msg);
}
{{ handle.return_type }} res = ({{ handle.return_type }}) jerry_get_number_value(res_value);
{% endmacro %}

{% macro boolean(library, handle, param) %}
{# other values than booleans are converted by their truthiness #}
{{ handle.return_type }} res = jerry_value_to_boolean(res_value);
{% endmacro %}
