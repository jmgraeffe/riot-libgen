{% import 'generators/js/templates/function_handle_parameters.tmpl' as tmpl_function_handle_parameters %}

{% macro void(library, function) %}
return jerry_create_undefined();
{% endmacro %}

{% macro struct(library, function) %}
jerry_value_t {{ tmpl_function_handle_parameters.struct(library, function, namespace(name='libgen_res', struct=function.returned_struct), 'ret')|trim }}
return ret;
{% endmacro %}

{% macro pointer_handle(library, function) %}
return jerry_create_number(pointer_handles_get_or_add_{{ library.name }}_{{ function.returned_pointer_handle }}((void*) libgen_res));
{% endmacro %}

{% macro number(library, function) %}
return jerry_create_number(libgen_res);
{% endmacro %}

{% macro boolean(library, function) %}
return jerry_create_boolean(libgen_res);
{% endmacro %}
